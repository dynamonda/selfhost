# /selfhost/scripts/media-sync.env のひな形。
#
#   cp media-sync.env.example media-sync.env
#   chmod 600 media-sync.env
#
# media-sync.env は git に入れない (.gitignore 済み)。

# Seafile の URL。ブラウザやクライアントから叩くのと同じもの
# (compose/seafile/.env の SEAFILE_SERVER_HOSTNAME と揃える)。
# API が返すダウンロード URL がこの名前で組み立てられるので、ここを
# コンテナ内部名 (http://seafile) にすると転送が失敗する。
SEAFILE_URL=http://server26.mullet-tiyanki.ts.net:10102

# 同期に使う Seafile アカウント。読めれば足りるので、管理者ではなく
# 動画ライブラリを共有した専用アカウントを作って使うのが望ましい。
SEAFILE_USER=

# rclone 用に難読化した「ログインパスワード」。
# Seafile のユーザー設定にある WebDAV パスワードとは別物なので注意。
# 平文ではなく、下の出力を貼る (README 参照。コマンドラインに直接書くと
# ! や $ がシェルに食われるので標準入力から渡す):
#   read -rsp 'password: ' p; echo; printf '%s' "$p" | \
#     docker run --rm -i rclone/rclone:1.68 obscure -
# (難読化であって暗号化ではない。元に戻せるのでファイルは chmod 600 にすること)
SEAFILE_PASS=

# 同期元のライブラリ名。Seafile の画面に出ている名前をそのまま書く。
SEAFILE_LIBRARY=Videos

# --- 任意 -------------------------------------------------------------------
# 暗号化ライブラリを使う場合はそのパスワード (平文)。通常は空のまま。
#SEAFILE_LIBRARY_KEY=
# アカウントで二要素認証を有効にしている場合は true。
#SEAFILE_2FA=false

# 同期先。外付けディスクに逃がすときはここを差し替える。
# Jellyfin には compose/jellyfin/media 経由で見えている必要があるので、
# 別の場所にするなら compose.yaml のマウントも合わせて直すこと。
#DEST=/selfhost/compose/jellyfin/media/seafile

# 1 回の同期で消してよいファイル数の上限 (安全弁)。
#MAX_DELETE=25

# rclone に足したい引数があれば。例: 帯域制限
#RCLONE_EXTRA_ARGS=--bwlimit 20M
