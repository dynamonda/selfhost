# compose/leantime/.env のひな形。
#
#   cp .env.example .env
#
# してから下の「要設定」を埋める。.env は git に入れない (.gitignore 済み)。
# 実体は restic のバックアップ対象に入れてある (backup.conf)。

# --- 要設定: 秘密情報 -------------------------------------------------------
# MySQL の lean ユーザーのパスワード。初回起動時に DB に焼き付くので、後から
# ここだけ変えても繋がらなくなる (変えるなら DB 側でも ALTER USER すること)。
# 生成例:
#   openssl rand -hex 24
DB_PASSWORD=

# セッションの暗号化鍵。変えても全員ログアウトされるだけ。
# 生成例:
#   openssl rand -hex 32
SESSION_PASSWORD=

# --- 任意 -------------------------------------------------------------------
# これも初回起動時に焼き付く。変えるなら初回起動の前に。
DB_DATABASE=leantime
DB_USER=lean
