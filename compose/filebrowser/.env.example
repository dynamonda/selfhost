# compose/filebrowser/.env のひな形。
#
#   cp .env.example .env
#
# してから下を全部埋める。.env は git に入れない (.gitignore 済み)。
# 実体は restic のバックアップ対象に入れてある (backup.conf)。

# 生成例:
#   openssl rand -hex 16   # FILEBROWSER_ADMIN_PASSWORD
#   openssl rand -hex 32   # FILEBROWSER_JWT_TOKEN_SECRET

# admin ユーザーのパスワード。起動のたびにこの値へ上書きされるので、
# パスワードを変えるときは UI ではなくここを書き換えて docker compose up -d する。
# config.yaml の minLength (12) 以上にすること。
FILEBROWSER_ADMIN_PASSWORD=

# ログインセッションと共有リンクの署名鍵。変えると既存のセッションと
# 共有リンクが全部無効になる。
FILEBROWSER_JWT_TOKEN_SECRET=
