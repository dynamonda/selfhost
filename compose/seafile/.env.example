# compose/seafile/.env のひな形。
#
#   cp .env.example .env
#
# してから下の「要設定」を全部埋める。.env は git に入れない (.gitignore 済み)。
# 実体は restic のバックアップ対象に入れてある (backup.conf)。ここを失うと
# DB は復元できてもアプリが復号・認証できなくなるため。

# --- 要設定: 秘密情報 -------------------------------------------------------
# 生成例:
#   openssl rand -hex 24   # パスワード類
#   openssl rand -hex 32   # JWT_PRIVATE_KEY (32 文字以上必須)
SEAFILE_MYSQL_DB_PASSWORD=
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=
JWT_PRIVATE_KEY=

# --- 要設定: 初回起動時にだけ使われる管理者 ---------------------------------
# 作成後の変更はここではなく Seafile の管理画面から行う。
INIT_SEAFILE_ADMIN_EMAIL=
INIT_SEAFILE_ADMIN_PASSWORD=

# --- ホスト名 ---------------------------------------------------------------
# ブラウザやクライアントから実際に叩くホスト:ポート。リバースプロキシを挟まず
# compose.yaml の 10102 を直接見せる構成なので、ポートまで含めて書く。
SEAFILE_SERVER_HOSTNAME=server26.mullet-tiyanki.ts.net:10102
SEAFILE_SERVER_PROTOCOL=http

# --- 任意 -------------------------------------------------------------------
TIME_ZONE=Asia/Tokyo
SEAFILE_MYSQL_DB_USER=seafile
# redis は compose 内部ネットワークにしか露出していないので空でも動く。
REDIS_PASSWORD=
